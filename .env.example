# ============================================================
# AI 内容鉴真私有化推理网关 - 环境变量配置
# 复制为 .env 后修改，切勿将 .env 提交到版本库
# ============================================================

# ----- 服务 -----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
APP_LOG_LEVEL=info
APP_ENV=production

# ----- 安全 -----
# 调用方需在 Header 中携带 X-API-Key，留空则不校验
API_KEY=
# 单张图片最大体积（MB）
MAX_UPLOAD_MB=20

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 缓存结果 TTL（秒），0 = 永久
CACHE_TTL=86400

# ----- 限流（令牌桶）-----
RATE_LIMIT_ENABLED=true
# 每秒生成令牌数
RATE_LIMIT_RATE=10
# 桶容量（突发上限）
RATE_LIMIT_CAPACITY=20

# ----- 推理引擎 -----
# 启用的模型 ID，逗号分隔
# 无权重模型（开箱即用）: freq_detector, ela_detector, noise_detector, cfa_detector, color_detector, mock
# 需权重模型: cnn_spotter, universal_fake, aeroblade
# 推荐生产配置（无需下载权重）: freq_detector,ela_detector,noise_detector,cfa_detector,color_detector
ENABLED_MODELS=freq_detector,ela_detector,noise_detector,cfa_detector,color_detector
# 融合策略: weighted_vote | max_prob | confidence_weighted
FUSION_STRATEGY=weighted_vote
# 批量推理
BATCH_MAX_SIZE=8
BATCH_TIMEOUT_MS=50
# 推理超时（秒）
INFERENCE_TIMEOUT=30

# ----- 模型权重目录 -----
MODEL_WEIGHTS_DIR=/app/models/weights

# ----- 可观测性 -----
PROMETHEUS_ENABLED=true
LOG_FORMAT=json
